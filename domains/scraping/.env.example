# Scraping API Server
PORT=3001
NODE_ENV=development

# Network & Fetcher Limits
MAX_STREAM_BYTES=10485760
FETCH_TIMEOUT_MS=15000
MAX_REDIRECTS=5

# Crawler Concurrency
GLOBAL_CONCURRENCY=8
PER_DOMAIN_CONCURRENCY=2

# Storage Configuration
STORAGE_DIR=./storage

# Optional Upstream Search Provider (Integration with domains/searching)
SEARCH_SERVICE_URL=http://127.0.0.1:3000

# Browser Rendering Fallback
ENABLE_PLAYWRIGHT_FALLBACK=true
