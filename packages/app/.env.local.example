PORT=3000

# SearXNG (packages/searxng, via infrastructure/docker-compose.yml)
BASE_URL=http://localhost:8080

# Go scraper service (packages/scraper, `go run ./cmd/server`)
SCRAPER_URL=http://localhost:8081
# How many search results are scraped per query (<= scraper SCRAPER_MAX_URLS)
MAX_SCRAPE_URLS=20
# Client-side deadline for one scrape batch; keep above the scraper SCRAPER_BATCH_TIMEOUT_SEC
SCRAPER_TIMEOUT_MS=35000
