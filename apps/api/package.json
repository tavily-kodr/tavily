{
  "name": "@tavily/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/**/*.test.js",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "@tavily/config": "workspace:*",
    "@tavily/errors": "workspace:*",
    "@tavily/logger": "workspace:*",
    "@tavily/scraping": "workspace:*",
    "@tavily/searching": "workspace:*",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  }
}
