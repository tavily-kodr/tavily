{
  "name": "@tavily/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --watch src/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@tavily/config": "workspace:*",
    "@tavily/errors": "workspace:*",
    "@tavily/logger": "workspace:*",
    "@tavily/searching": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.4",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
