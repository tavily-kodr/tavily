# Tavily Search Engine Environment Configuration

# Search Provider Configuration
# DuckDuckGo is the default zero-config provider (requires no API key)
DEFAULT_SEARCH_PROVIDER=duckduckgo

# Optional: Tavily API Key (if you want to use Tavily as the upstream provider)
TAVILY_API_KEY=

# Optional: Brave Search API Key
BRAVE_API_KEY=

# Optional: SearXNG Instance URL (e.g., https://searx.be)
SEARXNG_URL=

# AI Answer Generation (Optional)
# If provided, enables LLM grounded answers with citations
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Search & Scraping Resource Limits
MAX_RESULTS_LIMIT=20
MAX_PAGES_TO_SCRAPE=15
SCRAPER_TIMEOUT_MS=10000
SCRAPER_CONCURRENCY=5
SCRAPER_MAX_CONTENT_BYTES=2097152

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=600

# Server Configuration
PORT=3000
HOST=0.0.0.0
